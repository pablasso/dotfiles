[user]
  name = Juan Pablo Ortiz
  email = me@pablasso.com
  signingkey = 12C610E2
[core]
  excludesfile = /Users/pablasso/.gitignore_global
  editor = nvim
[color]
  ui = true
[github]
  user = pablasso
[push]
  default = simple
[credential]
  helper = osxkeychain
[commit]
  gpgsign = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
